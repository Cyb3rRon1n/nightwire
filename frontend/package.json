{
  "name": "nightwire-web",
  "version": "0.1.0",
  "private": true,
  "description": "Nightwire web client (Next.js); talks to the Python game server over WebSocket",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:tailscale": "next dev -H 0.0.0.0 -p 3002",
    "build": "next build",
    "start": "next start",
    "start:tailscale": "next start -H 0.0.0.0 -p 3002",
    "lint": "eslint",
    "test:nightwire": "node --test --experimental-strip-types \"tests/nightwire/*.test.ts\"",
    "check:image-routing": "node scripts/run-python.mjs scripts/check-image-server-routing.py",
    "check:image-server-http": "node scripts/run-python.mjs scripts/check-image-server-http.py",
    "image:server": "node scripts/start-image-server.mjs",
    "image:warm:mflux": "curl -sS -X POST http://127.0.0.1:7869/warm -H 'Content-Type: application/json' -d '{\"backend\":\"mflux-hs\"}'",
    "image:warm:sdnq": "curl -sS -X POST http://127.0.0.1:7869/warm -H 'Content-Type: application/json' -d '{\"backend\":\"sdnq-hs\"}'",
    "flux:worker": "npm run image:server"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "4.14.8",
    "react-use-websocket": "^4.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
